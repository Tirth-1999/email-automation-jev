{
  "name": "email-automation-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gmail ingestion and job-application email tracking",
  "scripts": {
    "gmail:auth": "tsx scripts/gmail-auth.ts",
    "ingest": "tsx scripts/ingest-gmail.ts",
    "ingest:full": "tsx scripts/ingest-gmail.ts --full",
    "ingest:resume": "tsx scripts/ingest-gmail.ts --full --resume",
    "inspect": "tsx scripts/inspect-emails.ts",
    "sample:emails": "tsx scripts/sample-emails.ts --count=150",
    "dashboard": "tsx apps/server/index.ts",
    "label:ui": "npm run dashboard",
    "jev:prepare": "tsx scripts/prepare-jev-eval.ts",
    "jev:evaluate": "tsx scripts/evaluate-jev.ts",
    "jev:evaluate:all": "tsx scripts/evaluate-jev.ts --all-labeled",
    "ai:evaluate": "tsx scripts/evaluate-llm-review.ts",
    "phase5:bootstrap": "tsx scripts/bootstrap-classification-data.ts",
    "classify": "tsx scripts/classify-emails.ts",
    "applications:group": "tsx scripts/group-applications.ts",
    "automate:once": "tsx scripts/run-automation.ts",
    "scheduler": "tsx scripts/run-automation.ts --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@typesafe-ai/sdk": "^0.6.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "dotenv": "^17.2.2",
    "googleapis": "^160.0.0",
    "html-to-text": "^9.0.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
