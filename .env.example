# Supabase project settings. Keep the service-role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Google OAuth desktop/web client credentials.
GMAIL_CLIENT_ID=replace_me.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=replace_me
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# Optional: use this instead of the ignored .gmail-token.json file.
# GMAIL_REFRESH_TOKEN=replace_me

# Initial import behavior.
GMAIL_QUERY=-in:drafts
GMAIL_INCLUDE_SPAM_TRASH=true
GMAIL_INCLUDE_OUTGOING=true
# 0 means no message-count limit. Use --limit=N for a test import.
GMAIL_MAX_MESSAGES=0
GMAIL_FETCH_CONCURRENCY=2
GMAIL_REQUESTS_PER_SECOND=2
GMAIL_MAX_RETRIES=8
GMAIL_UPSERT_BATCH_SIZE=100

# Jev classification and evaluation.
TYPESAFE_API_KEY=replace_me
TYPESAFE_MODEL=jev-1.13.0
JEV_MIN_TOP_PROBABILITY=0.60
JEV_DRAFT_REPLY_THRESHOLD=0.65
JEV_EVAL_CONCURRENCY=5

# Phase 6 defaults are configurable in the CLI and Command Center:
# concurrency 5, batch size 25, and at most 6 SDK retries per email.
