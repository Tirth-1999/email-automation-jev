# Supabase project settings. Keep the service-role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Google OAuth desktop/web client credentials.
GMAIL_CLIENT_ID=replace_me.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=replace_me
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# Optional: use this instead of the ignored .gmail-token.json file.
# GMAIL_REFRESH_TOKEN=replace_me

# Initial import behavior.
GMAIL_QUERY=-in:drafts
GMAIL_INCLUDE_SPAM_TRASH=true
GMAIL_INCLUDE_OUTGOING=true
# 0 means no message-count limit. Use --limit=N for a test import.
GMAIL_MAX_MESSAGES=0
GMAIL_FETCH_CONCURRENCY=2
GMAIL_REQUESTS_PER_SECOND=2
GMAIL_MAX_RETRIES=8
GMAIL_UPSERT_BATCH_SIZE=100

# Jev classification and evaluation.
TYPESAFE_API_KEY=replace_me
TYPESAFE_MODEL=jev-1.13.0
JEV_MIN_TOP_PROBABILITY=0.60
JEV_DRAFT_REPLY_THRESHOLD=0.65
JEV_EVAL_CONCURRENCY=5
JEV_APPLICATION_MATCH_THRESHOLD=0.72
JEV_APPLICATION_MATCH_CONCURRENCY=8
JEV_APPLICATION_MAX_PAIRS_PER_THREAD=24

# Phase 10 application lifecycle. Applied/outreach-only applications become
# ghosted after this many days without a later hiring-process event.
APPLICATION_GHOST_DAYS=21

# Optional Phase 8 reply drafting. Email context is sent only when you click
# Generate draft. Responses are requested with store=false and never auto-sent.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
# Optional comma-separated allowlist shown in the model selectors.
OPENAI_MODELS=gpt-4o-mini
REPLY_WRITING_PROFILE=Write as Tirth Shah in a concise, warm, professional tone. Never invent facts or commitments.

# Phase 11 hourly automation. Keep disabled operationally until migration 007
# is applied, then run `npm run scheduler` under a process manager or deploy it
# as an hourly job with `npm run automate:once`.
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_MINUTES=60
AUTOMATION_LOCK_TTL_SECONDS=10800
AUTOMATION_JEV_CONCURRENCY=5
AUTOMATION_JEV_BATCH_SIZE=25
AUTOMATION_JEV_MAX_RETRIES=6
# Optional HTTPS webhook. Payloads contain only stage, counts, duration, and a
# sanitized error; email headers and bodies are never included.
OPERATIONS_ALERT_WEBHOOK_URL=

# Phase 6 defaults are configurable in the CLI and Command Center:
# concurrency 5, batch size 25, and at most 6 SDK retries per email.
